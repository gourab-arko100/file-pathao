# These are auto-filled by Vercel when you add a "Vercel KV" (Upstash Redis)
# storage integration to your project. For local dev, run `vercel env pull .env.local`
# after creating the KV store, or paste the values from the Vercel dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# Optional: a TURN server for reliable NAT traversal on restrictive networks
# (e.g. from https://www.metered.ca/tools/openrelay/ free tier).
# Leave blank to use STUN only, which works for most home/mobile networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
